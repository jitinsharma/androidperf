<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>androidperf · {{ meta.package }}</title>
    <style>
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                         "Helvetica Neue", Arial, sans-serif;
            background: #0f1115;
            color: #e6e9ef;
            font-size: 14px;
            line-height: 1.5;
        }
        .wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }
        header {
            padding-bottom: 24px;
            border-bottom: 1px solid #1d2230;
            margin-bottom: 24px;
        }
        header h1 {
            margin: 0 0 4px 0;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        header h1 small {
            font-weight: 400;
            color: #8a94a6;
            font-size: 14px;
            margin-left: 10px;
        }
        header .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px 24px;
            margin-top: 16px;
        }
        header .meta-grid div {
            font-size: 12px;
        }
        header .meta-grid label {
            display: block;
            color: #6b7689;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-size: 10px;
            margin-bottom: 2px;
        }
        header .meta-grid span { color: #e6e9ef; font-weight: 500; }
        .summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 24px;
        }
        .stat {
            background: #141823;
            border: 1px solid #1d2230;
            border-radius: 8px;
            padding: 12px 14px;
        }
        .stat .k {
            color: #6b7689;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .stat .v {
            font-size: 20px;
            font-weight: 600;
        }
        .stat .sub {
            color: #8a94a6;
            font-size: 11px;
            margin-top: 2px;
        }
        section.chart {
            background: #141823;
            border: 1px solid #1d2230;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
        }
        section.chart h2 {
            margin: 0 0 12px 0;
            font-size: 14px;
            font-weight: 500;
            color: #a3adc2;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
        .insights { margin-bottom: 28px; }
        .insights h2 {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #a3adc2;
            margin: 0 0 12px 0;
        }
        .finding-card {
            background: #141823;
            border: 1px solid #1d2230;
            border-left-width: 4px;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }
        .finding-card.critical { border-left-color: #ef4444; }
        .finding-card.warning  { border-left-color: #f59e0b; }
        .finding-card.info     { border-left-color: #60a5fa; }
        .finding-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }
        .finding-badge {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 7px;
            border-radius: 4px;
        }
        .badge-critical { background: #7f1d1d; color: #fca5a5; }
        .badge-warning  { background: #78350f; color: #fcd34d; }
        .badge-info     { background: #1e3a5f; color: #93c5fd; }
        .badge-cat      { background: #1d2230; color: #8a94a6; }
        .finding-title  { font-size: 14px; font-weight: 600; color: #e6e9ef; }
        .finding-desc   { font-size: 13px; color: #a3adc2; margin-bottom: 6px; }
        .finding-meta   { font-size: 11px; color: #4b5568; margin-top: 6px; }
        footer {
            margin-top: 32px;
            padding-top: 16px;
            border-top: 1px solid #1d2230;
            color: #6b7689;
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="wrap">
    <header>
        <h1>androidperf <small>· {{ meta.package }}</small></h1>
        <div class="meta-grid">
            <div><label>Device</label><span>{{ meta.device.manufacturer }} {{ meta.device.model }}</span></div>
            <div><label>SDK</label><span>{{ meta.device.sdk }}</span></div>
            <div><label>PID / UID</label><span>{{ meta.pid }} / {{ meta.uid }}</span></div>
            <div><label>Started</label><span>{{ meta.started_at }}</span></div>
            <div><label>Ended</label><span>{{ meta.ended_at }}</span></div>
            <div><label>Interval</label><span>{{ meta.interval_s }}s</span></div>
            <div><label>Samples</label><span>{{ meta.sample_count }}</span></div>
        </div>
    </header>

    <div class="summary">
        {% for card in summary_cards %}
        <div class="stat">
            <div class="k">{{ card.label }}</div>
            <div class="v">{{ card.value }}</div>
            {% if card.sub %}<div class="sub">{{ card.sub }}</div>{% endif %}
        </div>
        {% endfor %}
    </div>

    {% if findings %}
    <section class="insights">
        <h2>Insights ({{ findings | length }})</h2>
        {% for f in findings %}
        <div class="finding-card {{ f.severity }}">
            <div class="finding-header">
                <span class="finding-badge badge-{{ f.severity }}">{{ f.severity }}</span>
                <span class="finding-badge badge-cat">{{ f.category }}</span>
                <span class="finding-title">{{ f.title }}</span>
            </div>
            <div class="finding-desc">{{ f.description }}</div>
            {% if f.timestamps %}
            <div class="finding-meta">
                First at {{ f.timestamps[0] }}s
                · {{ f.timestamps | length }} occurrence(s)
                {% if f.peak_value is not none %} · peak {{ f.peak_value }}{% endif %}
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </section>
    {% endif %}

    {% for chart in charts %}
    <section class="chart">
        <h2>{{ chart.title }}</h2>
        {{ chart.html | safe }}
    </section>
    {% endfor %}

    <footer>Generated by androidperf</footer>
</div>
</body>
</html>
